# URL base del backend (Express). En desarrollo, el backend corre en
# localhost:4000 por defecto (ver backend/.env.example).
VITE_API_BASE_URL="http://localhost:4000"

# NO poner VITE_ENABLE_MODO_PRUEBA aquí. Esa variable vive solo en
# .env.development (cargada nada más por `electron-vite dev`) para que un
# build de producción (`electron-vite build`, modo production) jamás incluya
# el input manual de trabajadorId que sustituye al lector biométrico
# mientras no llega el hardware Horus E1-FP.
