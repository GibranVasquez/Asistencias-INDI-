{
  "name": "indi-asistencia-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API backend (Node.js + TypeScript + Express + Prisma) para el Sistema INDI de Asistencia y Nomina - Obra Tren Golfo de Mexico.",
  "main": "dist/index.js",
  "scripts": {
    "predev": "ts-node --transpile-only src/config/preflightDev.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:db:up": "docker compose -p indi-integration-test -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -p indi-integration-test -f docker-compose.test.yml down --remove-orphans",
    "test:db:migrate": "node scripts/run-test-db-command.mjs migrate",
    "test:db:seed": "node scripts/run-test-db-command.mjs seed",
    "test:db:guards": "node --test scripts/test-database-guard.test.mjs scripts/migration/url-guard.test.mjs",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "migration:test": "bash scripts/migration/run-local-rehearsal.sh",
    "migration:test:guards": "node --test scripts/migration/url-guard.test.mjs",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck:prisma": "tsc --noEmit -p tsconfig.prisma.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
