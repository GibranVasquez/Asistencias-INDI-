// Sistema INDI de Asistencia y Nomina — Obra Tren Golfo de Mexico.
// Convenciones (alineadas con backend/Control_Grupo_INDIv2, el otro backend
// de Grupo INDI): campos camelCase en Prisma mapeados a columnas snake_case
// via @map()/@@map(); ids uuid generados por Postgres (gen_random_uuid(),
// nativo desde PG13, sin necesidad de extensiones); dinero en Decimal;
// timestamps en Timestamptz(6); fechas sin hora en Date.
//
// TODO (sesión futura dedicada, no implementado a propósito): ningún modelo
// editable tiene updatedAt/version — todo edit() de este proyecto hace un
// UPDATE incondicional por id, así que dos ediciones concurrentes al mismo
// registro terminan en last-write-wins silencioso, sin ningún 409/aviso de
// conflicto para ninguna de las dos partes (confirmado auditando todos los
// servicios de edición: trabajador, nomina, horario, seccion, tipoMovimiento,
// tarifaHoraExtra, usuario, terminal — mismo patrón sin excepción). Prioridad
// si se aborda: Trabajador y NominaSemanal primero (datos de nómina — el
// caso real más probable es 2 personas de RH editando al mismo trabajador o
// corrigiendo la misma nómina casi al mismo tiempo), después el resto.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: conexión pooled (pgbouncer, puerto 6543 en Supabase) — la
  // usa la app en runtime (utils/prisma.ts vía @prisma/adapter-pg).
  // DIRECT_URL: conexión directa (puerto 5432) — solo la usa el motor de
  // migraciones de Prisma; pgbouncer en modo transacción no soporta los
  // prepared statements que `migrate deploy`/`migrate dev` necesitan.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------
// 1. ENUMS
// ---------------------------------------------------------------------

enum RolUsuario {
  trabajador
  recepcion
  encargado_seccion
  rh
  administrador

  @@map("rol_usuario")
}

enum TrabajadorTipo {
  empleado
  contratista
  becario

  @@map("trabajador_tipo")
}

enum TrabajadorEstatus {
  activo
  baja

  @@map("trabajador_estatus")
}

enum MetodoAsistencia {
  huella
  rostro

  @@map("metodo_asistencia")
}

enum NominaEstatus {
  pendiente
  pagado
  con_incidencia

  @@map("nomina_estatus")
}

enum EstadoConexionTerminal {
  conectado
  desconectado

  @@map("estado_conexion_terminal")
}

// ---------------------------------------------------------------------
// 2. USUARIOS (cuentas del sistema — no confundir con Trabajador)
// ---------------------------------------------------------------------

model Usuario {
  id                     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username               String     @unique
  passwordHash           String     @map("password_hash")
  rol                    RolUsuario
  activo                 Boolean    @default(true)
  // true tras un reseteo de contraseña por administrador (password
  // temporal); el login sigue funcionando con esa temporal, pero el
  // frontend bloquea el resto de la app hasta que el usuario la cambie por
  // una propia via PATCH /auth/cambiar-password.
  requiereCambioPassword Boolean    @default(false) @map("requiere_cambio_password")
  // Bloqueo por intentos fallidos (auth.service.ts) — independiente del
  // rate limit por IP/usuario de middlewares/rateLimit.ts: ese limita
  // cuántas peticiones puede hacer un origen en una ventana de tiempo;
  // esto bloquea la CUENTA específica sin importar desde qué IP vengan los
  // intentos. intentosFallidos se resetea a 0 tras un login exitoso;
  // bloqueadoHasta queda null mientras la cuenta no esté bloqueada.
  intentosFallidos       Int        @default(0) @map("intentos_fallidos")
  bloqueadoHasta         DateTime?  @map("bloqueado_hasta") @db.Timestamptz(6)
  // Solo se llena para cuentas rol=trabajador (el kiosco autentica al
  // trabajador contra su propio registro). Único: un trabajador tiene a lo
  // más una cuenta.
  trabajadorId           String?    @unique @map("trabajador_id") @db.Uuid
  creadoEn               DateTime   @default(now()) @map("creado_en") @db.Timestamptz(6)

  trabajador          Trabajador?        @relation(fields: [trabajadorId], references: [id])
  seccionesAsignadas  Seccion[]          @relation("SeccionEncargados")
  auditLogs           AuditLog[]
  asignacionesCreadas AsignacionDiaria[]

  @@index([rol], map: "idx_usuarios_rol")
  @@map("usuarios")
}

// ---------------------------------------------------------------------
// 3. TRABAJADORES
// ---------------------------------------------------------------------

// TODO concurrencia optimista pendiente (ver nota al inicio del archivo) —
// prioridad #1 junto con NominaSemanal.
model Trabajador {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombreCompleto           String            @map("nombre_completo")
  categoria                String
  // Texto libre (nombre del jefe/encargado inmediato tal como viene del
  // roster de nomina) — no es FK: muchos jefes/ingenieros no son ellos
  // mismos un Trabajador dado de alta en el sistema.
  jefeInmediato            String            @map("jefe_inmediato")
  tipo                     TrabajadorTipo    @default(empleado)
  // Nullable: el alta inicial (ej. roster de enrolamiento biometrico) no
  // siempre trae los datos de nomina todavia — RH los completa despues.
  fechaIngreso             DateTime?         @map("fecha_ingreso") @db.Date
  sueldoBase               Decimal?          @map("sueldo_base") @db.Decimal(12, 2)
  banco                    String?
  clabe                    String?
  cuentaBancaria           String?           @map("cuenta_bancaria")
  // Solo informativo — no se usa para calcular nada, INFONAVIT no se deriva
  // de este plazo. Ver infonavitMontoPorPeriodo.
  infonavitPlazoMeses      Int?              @map("infonavit_plazo_meses")
  // Monto que INFONAVIT ya notificó para este trabajador; RH lo captura a
  // mano y la nómina lo usa tal cual como descuento, sin derivarlo de
  // infonavitPlazoMeses ni de ningún otro campo.
  infonavitMontoPorPeriodo Decimal?          @map("infonavit_monto_por_periodo") @db.Decimal(12, 2)
  huellaRegistrada         Boolean           @default(false) @map("huella_registrada")
  rostroRegistrado         Boolean           @default(false) @map("rostro_registrado")
  // ID numérico con el que la persona se enroló en un lector biométrico
  // ADMS (ZKTeco MB10-VL de oficina) — nullable porque no todos los
  // trabajadores se enrolan ahí (el roster de campo original no traía
  // este dato, y el enrolamiento en sí ocurre en el equipo, no aquí). RH
  // lo captura a mano para que coincida con el PIN real usado al enrolar
  // a esa persona en el equipo — ver adms.service.ts.
  numeroChecador           Int?              @unique @map("numero_checador")
  estatus                  TrabajadorEstatus @default(activo)
  creadoEn                 DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario      Usuario?
  asistencias  AsistenciaDiaria[]
  movimientos  MovimientoTrabajador[]
  nominas      NominaSemanal[]
  asignaciones AsignacionDiaria[]
  seccionesResponsableTramo Seccion[] @relation("SeccionResponsablesTramo")

  @@index([estatus], map: "idx_trabajadores_estatus")
  @@map("trabajadores")
}

// Catálogo de sueldo por defecto por categoría — Trabajador.categoria se
// queda como String libre a propósito (no se convierte en FK): el roster
// real tiene ~52 valores distintos, varios el mismo puesto escrito de
// formas distintas (ej. "OP EXCAVADORA"/"OPERADOR DE EXCAVADORA"/
// "OP.EXCAVADORA"), así que forzar una relación exigiría una reconciliación
// manual de RH que nadie ha hecho todavía. sueldoBaseDefault solo prellena
// el campo sueldoBase al DAR DE ALTA un trabajador nuevo (editable antes de
// guardar) — no es un valor vivo que Trabajador.sueldoBase siga
// referenciando después. Confirmado en nomina.service.ts: sueldoBase se
// copia (snapshot) dentro de NominaSemanal.montoSueldo al generar la
// nómina, nunca se relee en vivo — así que ni esta tabla ni la acción de
// "aplicar a todos" (ver categoriaTrabajador.service.ts) pueden alterar
// nóminas ya generadas, solo las que se generen después del cambio.
model CategoriaTrabajador {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre            String   @unique
  sueldoBaseDefault Decimal? @map("sueldo_base_default") @db.Decimal(12, 2)
  // Cuando ninguna categoría real del trabajador coincide con el nombre de
  // ninguna fila de este catálogo, el formulario de alta cae aquí — caso
  // "sueldo fijo para todos" sin inventar un mecanismo global paralelo. El
  // servicio garantiza como máximo una fila con esDefault=true (ver
  // categoriaTrabajador.service.ts).
  esDefault         Boolean  @default(false) @map("es_default")
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@map("categorias_trabajador")
}

// ---------------------------------------------------------------------
// 4. OBRA Y SECCIONES
// ---------------------------------------------------------------------

model Obra {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre       String
  timezoneObra String?  @map("timezone_obra")
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  secciones Seccion[]

  @@map("obras")
}

model Seccion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  obraId    String   @map("obra_id") @db.Uuid
  nombre    String
  // Referencia física del frente (tramo, kilometraje o ubicación). Es
  // opcional porque las secciones existentes pueden no tenerla todavía.
  tramoUbicacion String? @map("tramo_ubicacion")
  // Nullable: no toda seccion tiene un horario esperado asignado desde el
  // alta. Resuelve el vinculo que faltaba entre asistencia y horario --
  // AsistenciaDiaria ya registra en que seccion se marco cada asistencia,
  // asi que puntualidad/tardanza se calculan via seccion.horarioId, sin
  // inventar una relacion nueva ni fijar Trabajador a un horario.
  horarioId String?  @map("horario_id") @db.Uuid
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  obra         Obra               @relation(fields: [obraId], references: [id])
  horario      Horario?           @relation(fields: [horarioId], references: [id])
  encargados   Usuario[]          @relation("SeccionEncargados")
  responsablesTramo Trabajador[]  @relation("SeccionResponsablesTramo")
  asistencias  AsistenciaDiaria[]
  asignaciones AsignacionDiaria[]

  @@unique([obraId, nombre])
  @@index([obraId], map: "idx_secciones_obra")
  @@index([horarioId], map: "idx_secciones_horario")
  @@map("secciones")
}

// ---------------------------------------------------------------------
// 5. HORARIOS (catalogo abierto — oficina, y los de campo por definir)
// ---------------------------------------------------------------------

model Horario {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre            String    @unique
  horaEntrada       DateTime  @map("hora_entrada") @db.Time(0)
  horaSalida        DateTime  @map("hora_salida") @db.Time(0)
  toleranciaMinutos Int       @map("tolerancia_minutos")
  // Receso opcional (ej. "Oficina" 08:00-20:00 con receso 14:00-16:00). Nulos
  // en horarios sin receso definido (ej. los de campo, aun por confirmar).
  recesoInicio      DateTime? @map("receso_inicio") @db.Time(0)
  recesoFin         DateTime? @map("receso_fin") @db.Time(0)
  creadoEn          DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  secciones Seccion[]

  @@map("horarios")
}

// ---------------------------------------------------------------------
// 6. ASISTENCIA DIARIA
// ---------------------------------------------------------------------

model AsistenciaDiaria {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trabajadorId     String           @map("trabajador_id") @db.Uuid
  fecha            DateTime         @db.Date
  hora             DateTime         @db.Time(0)
  // La seccion se registra junto con la asistencia del dia (un trabajador NO
  // pertenece de forma fija a una seccion, puede cambiar de un dia a otro).
  seccionId        String           @map("seccion_id") @db.Uuid
  turno            String
  metodoUsado      MetodoAsistencia @map("metodo_usado")
  terminalOrigenId String           @map("terminal_origen_id") @db.Uuid
  ubicacionGPS     String?          @map("ubicacion_gps")
  creadoEn         DateTime         @default(now()) @map("creado_en") @db.Timestamptz(6)

  trabajador     Trabajador @relation(fields: [trabajadorId], references: [id])
  seccion        Seccion    @relation(fields: [seccionId], references: [id])
  terminalOrigen Terminal   @relation(fields: [terminalOrigenId], references: [id])

  @@index([trabajadorId, fecha], map: "idx_asistencias_trabajador_fecha")
  @@index([seccionId, fecha], map: "idx_asistencias_seccion_fecha")
  // Mismo natural key que ya usa adms.service.ts (yaExisteAsistencia) para
  // detectar reenvios del mismo backlog -- antes solo era un chequeo de
  // aplicacion sin respaldo real en la base, asi que dos escrituras
  // realmente concurrentes (equipo con reintento agresivo mientras la
  // peticion anterior seguia en proceso, o un doble tap del Kiosco dentro
  // del mismo minuto) podian crear dos filas idénticas. No bloquea
  // marcaciones legitimas multiples el mismo dia (entrada/salida): esas
  // tienen una `hora` distinta, asi que caen fuera de esta restriccion.
  @@unique([trabajadorId, terminalOrigenId, fecha, hora], map: "uq_asistencias_trabajador_terminal_fecha_hora")
  @@map("asistencias_diarias")
}

// ---------------------------------------------------------------------
// 6B. ASIGNACIONES DIARIAS (a que seccion se espera cada trabajador cada
// dia — separado de AsistenciaDiaria, que registra donde SI se presento).
// Un trabajador solo puede estar asignado a una seccion por dia.
// ---------------------------------------------------------------------

model AsignacionDiaria {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trabajadorId String   @map("trabajador_id") @db.Uuid
  seccionId    String   @map("seccion_id") @db.Uuid
  fecha        DateTime @db.Date
  asignadoPor  String   @map("asignado_por") @db.Uuid
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  trabajador Trabajador @relation(fields: [trabajadorId], references: [id])
  seccion    Seccion    @relation(fields: [seccionId], references: [id])
  usuario    Usuario    @relation(fields: [asignadoPor], references: [id])

  @@unique([trabajadorId, fecha])
  @@index([seccionId, fecha], map: "idx_asignaciones_seccion_fecha")
  @@map("asignaciones_diarias")
}

// ---------------------------------------------------------------------
// 7. MOVIMIENTOS (catalogo configurable por RH + bitacora por trabajador)
// ---------------------------------------------------------------------

model TipoMovimiento {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                 String   @unique
  cuentaComoDiaTrabajado Boolean  @map("cuenta_como_dia_trabajado")
  esInformativo          Boolean  @map("es_informativo")
  requiereAutorizacion   Boolean  @map("requiere_autorizacion")
  creadoEn               DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  movimientos MovimientoTrabajador[]

  @@map("tipos_movimiento")
}

model MovimientoTrabajador {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trabajadorId     String    @map("trabajador_id") @db.Uuid
  tipoMovimientoId String    @map("tipo_movimiento_id") @db.Uuid
  fechaInicio      DateTime  @map("fecha_inicio") @db.Date
  fechaFin         DateTime? @map("fecha_fin") @db.Date
  nota             String?
  creadoEn         DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  trabajador     Trabajador     @relation(fields: [trabajadorId], references: [id])
  tipoMovimiento TipoMovimiento @relation(fields: [tipoMovimientoId], references: [id])

  @@index([trabajadorId], map: "idx_movimientos_trabajador")
  @@index([tipoMovimientoId], map: "idx_movimientos_tipo")
  @@map("movimientos_trabajador")
}

// ---------------------------------------------------------------------
// 8. NOMINA
// ---------------------------------------------------------------------

model TarifaHoraExtra {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  valor        Decimal  @db.Decimal(10, 2)
  vigenteDesde DateTime @unique @map("vigente_desde") @db.Date
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  @@map("tarifas_hora_extra")
}

// TODO concurrencia optimista pendiente (ver nota al inicio del archivo) —
// prioridad #1 junto con Trabajador.
model NominaSemanal {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trabajadorId       String        @map("trabajador_id") @db.Uuid
  periodoInicio      DateTime      @map("periodo_inicio") @db.Date
  periodoFin         DateTime      @map("periodo_fin") @db.Date
  diasLaborados      Decimal       @map("dias_laborados") @db.Decimal(4, 2)
  montoSueldo        Decimal       @map("monto_sueldo") @db.Decimal(12, 2)
  horasExtra         Decimal       @map("horas_extra") @db.Decimal(6, 2)
  montoHorasExtra    Decimal       @map("monto_horas_extra") @db.Decimal(12, 2)
  viaticosSemanal    Decimal       @map("viaticos_semanal") @db.Decimal(12, 2)
  viaticosMensual    Decimal       @map("viaticos_mensual") @db.Decimal(12, 2)
  infonavitDescuento Decimal       @map("infonavit_descuento") @db.Decimal(12, 2)
  descuentosVarios   Decimal       @map("descuentos_varios") @db.Decimal(12, 2)
  aguinaldo          Decimal?      @db.Decimal(12, 2)
  totalAPagar        Decimal       @map("total_a_pagar") @db.Decimal(12, 2)
  estatus            NominaEstatus @default(pendiente)
  creadoEn           DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)

  trabajador Trabajador @relation(fields: [trabajadorId], references: [id])

  @@unique([trabajadorId, periodoInicio])
  @@index([trabajadorId], map: "idx_nominas_trabajador")
  @@index([periodoInicio], map: "idx_nominas_periodo")
  @@map("nominas_semanales")
}

// ---------------------------------------------------------------------
// 9. TERMINALES (kioscos biometricos)
// ---------------------------------------------------------------------

model Terminal {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Credencial propia del dispositivo (no es un Usuario/RolUsuario): el
  // kiosco autentica como terminal, nunca como el trabajador que se marca.
  username             String                 @unique
  passwordHash         String                 @map("password_hash")
  // Independiente de estadoConexion: activo/inactivo es si el terminal está
  // dado de alta y autorizado a operar; estadoConexion es su conectividad
  // momentánea (heartbeat/sincronización).
  activo               Boolean                @default(true)
  // Texto libre a proposito: el hardware de campo (ZKTeco Horus E1-FP) aun
  // no tiene protocolo confirmado. El lector fijo de oficina (ZKTeco
  // MB10-VL) sí quedó confirmado — protocolo ADMS — y usa tipo="adms" para
  // que adms.service.ts sepa que este Terminal no tiene sesión JWT propia
  // (nunca hace login-terminal; el equipo no habla nuestro protocolo de
  // auth en absoluto), sino que se identifica por numeroSerie en cada
  // petición ADMS.
  tipo                 String
  ubicacion            String
  // Número de serie real del equipo — solo aplica a terminales tipo="adms"
  // (el protocolo ADMS no tiene autenticación propia; validar el SN contra
  // este campo es la única verificación de "es un equipo que nosotros
  // dimos de alta", no una autenticación fuerte — ver adms.service.ts y
  // CLAUDE.md para el resto de la mitigación real, que es de red).
  numeroSerie          String?                @unique @map("numero_serie")
  estadoConexion       EstadoConexionTerminal @default(desconectado) @map("estado_conexion")
  ultimaSincronizacion DateTime?              @map("ultima_sincronizacion") @db.Timestamptz(6)
  creadoEn             DateTime               @default(now()) @map("creado_en") @db.Timestamptz(6)

  asistencias           AsistenciaDiaria[]
  eventosNoReconciliados EventoNoReconciliado[]

  @@map("terminales")
}

// Un push ADMS cuyo PIN no coincide con ningun Trabajador.numeroChecador —
// no se descarta en silencio ni se inventa un Trabajador: queda aqui para
// que RH lo revise y, si hace falta, complete el numeroChecador que falta
// (typo al capturarlo, alguien se enroló en el equipo antes de que RH lo
// diera de alta en el sistema, etc.).
model EventoNoReconciliado {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  terminalId     String   @map("terminal_id") @db.Uuid
  // Texto, no Int: el PIN tal cual lo mandó el equipo — no vale la pena
  // que un PIN no-numerico (formato distinto en otro modelo/firmware)
  // tumbe la reconciliacion en vez de solo quedar sin poder resolverse.
  pinDispositivo String   @map("pin_dispositivo")
  // Tiempo civil reportado por ADMS; no representa un instante UTC.
  fechaMarcacion DateTime? @map("fecha_marcacion") @db.Date
  horaMarcacion  DateTime? @map("hora_marcacion") @db.Time(0)
  marcadoEn      DateTime @map("marcado_en") @db.Timestamptz(6)
  // Codigo de metodo de verificacion tal cual vino (0/1/2/4/15/...), sin
  // mapear — el mapeo a huella/rostro puede no cubrir todos los valores
  // reales que el equipo mande.
  metodoCrudo    String   @map("metodo_crudo")
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  terminal Terminal @relation(fields: [terminalId], references: [id])

  @@index([terminalId], map: "idx_eventos_no_reconciliados_terminal")
  @@map("eventos_no_reconciliados")
}

// ---------------------------------------------------------------------
// 10. AUDITORIA
// ---------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  accion    String
  entidad   String
  entidadId String   @map("entidad_id") @db.Uuid
  fecha     DateTime @default(now()) @db.Timestamptz(6)
  detalle   Json?

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([entidad, entidadId], map: "idx_audit_log_entidad")
  @@index([usuarioId], map: "idx_audit_log_usuario")
  @@map("audit_log")
}
