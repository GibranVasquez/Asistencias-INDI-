# Postgres administrado por Supabase. DATABASE_URL es la conexión pooled
# (pgbouncer, puerto 6543) que usa la app en runtime; DIRECT_URL es la
# conexión directa (puerto 5432) que solo usa el motor de migraciones de
# Prisma (pgbouncer en modo transacción no soporta prepared statements).
# Ambas deben incluir ?sslmode=require si Supabase no lo agrega ya por
# default en el string que da su dashboard (Project Settings > Database).
DATABASE_URL="postgresql://user:password@aws-pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@db.supabase.co:5432/postgres?sslmode=require"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"
PORT=4000
NODE_ENV=development

# Origen permitido para CORS (la app Electron/React). En desarrollo, usa el host:puerto
# donde corre el frontend (ej. http://localhost:5173). No usar "*" en producción.
ALLOWED_ORIGIN="http://localhost:PUERTO"

# Cuenta inicial de administrador (unico rol que puede crear/dar de baja cuentas).
# Solo se usa la primera vez que corre el seed; si ya existe un usuario con este
# username, el seed no sobreescribe su password.
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="change-me-too"
